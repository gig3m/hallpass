# Maintainer: Kyle Arrington <kyle at arrington dot co>
pkgname=hallpass
pkgver=0.1.1
pkgrel=1
pkgdesc='TUI for granting yourself access to USB devices via udev uaccess rules (WebUSB, WebHID, DFU flashers)'
arch=('x86_64' 'aarch64')
url='https://github.com/gig3m/hallpass'
license=('MIT')
depends=('glibc' 'systemd' 'acl' 'sudo')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('39c2a536b1e2cd325fd4fd42d5f9b539e3ccf636af950b75c347de52bdd429ba')

prepare() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  go mod download -modcacherw
}

build() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  go build -ldflags "-linkmode=external -X main.version=v$pkgver" -o hallpass .
}

check() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 hallpass "$pkgdir/usr/bin/hallpass"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
